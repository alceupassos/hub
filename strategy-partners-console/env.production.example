# Copie para .env.production na VPS (NÃO commitar — .env* é ignorado por git e docker).
# PLAYGROUND STRATEGY PARTNER · deploy em hub.strategypartners.com.br. Ver DEPLOY.md.

# ── LLM de chat (mínimo para subir) ───────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash
DEEPSEEK_MODEL_REASONER=deepseek-v4-pro

# ── Banco de dados + RAG (mesma VPS do semantix, schema isolado strategy_partners) ─
# Rodar antes: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://usuario:senha@host:5432/strategy_partners
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=text-embedding-004

# ── Camada Anthropic / Eixo B (opcional) ──────────────────────────────────────
USE_ANTHROPIC_TIERS=false
ANTHROPIC_API_KEY=
ANTHROPIC_OPUS_MODEL=claude-opus-4-8
ANTHROPIC_FABLE_MODEL=claude-fable-5
ANTHROPIC_SONNET_MODEL=claude-sonnet-5

# ── Auth / RBAC ───────────────────────────────────────────────────────────────
LEGACY_DAILY_CODE_AUTH=true
AUTH_SECRET=            # openssl rand -base64 32
ADMIN_BOOTSTRAP_TOKEN=  # para criar o 1º admin via POST /api/admin/bootstrap
